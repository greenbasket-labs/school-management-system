// use prisma-next

// ============================================================
// SCHOOL MANAGEMENT SYSTEM
// PHASE 1 — FOUNDATION
// ============================================================

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserType {
  OWNER
  ADMIN
  TEACHER
  CASHIER
  STUDENT
  PARENT
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTerm {
  FIRST
  SECOND
  THIRD
}

enum AcademicSessionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
  INACTIVE
}

enum AttendancePeriod {
  FIRST_PERIOD
  SECOND_PERIOD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ------------------------------------------------------------
// EXAM ENUMS
// ------------------------------------------------------------
enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// ------------------------------------------------------------
// SCHOOL
// ------------------------------------------------------------
model School {
  id                Int                        @id @default(autoincrement())
  name              String
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  website           String?
  registrationInfo  String?
  motto             String?
  principalName     String?

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  users             User[]
  academicSessions  AcademicSession[]
  classes           SchoolClass[]
  subjects          Subject[]
  students          Student[]
  parents           Parent[]
  teachers          Teacher[]

  feeTypes          FeeType[]
  feeAssignments    FeeAssignment[]
  payments          Payment[]
  receipts          Receipt[]

  attendanceSetting AttendanceSetting?
  attendanceRecords AttendanceRecord[]

  exams             Exam[]
}

// ------------------------------------------------------------
// USERS
// ------------------------------------------------------------
model User {
  id                Int                        @id @default(autoincrement())
  schoolId          Int
  permanentId       String                     @unique
  email             String?
  username          String?
  phone             String?
  passwordHash      String
  name              String
  userType          UserType
  status            UserStatus                 @default(PENDING)

  school            School                     @relation(fields:[schoolId], references:[id])

  roles             UserRole[]
  auditLogs         AuditLog[]

  paymentsReceived  Payment[]

  attendanceRecords AttendanceRecord[]

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([schoolId])
  @@index([status])
  @@index([userType])

  @@unique([schoolId, username])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
}

// ------------------------------------------------------------
// ROLES
// ------------------------------------------------------------
model Role {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  isSystem    Boolean                    @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([name])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int

  user   User @relation(fields:[userId], references:[id])
  role   Role @relation(fields:[roleId], references:[id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id          Int                        @id @default(autoincrement())
  code        String                     @unique
  name        String
  description String?

  roles       RolePermission[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role         Role       @relation(fields:[roleId], references:[id])
  permission   Permission @relation(fields:[permissionId], references:[id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ------------------------------------------------------------
// ACADEMIC SESSION
// ------------------------------------------------------------
model AcademicSession {
  id             Int                        @id @default(autoincrement())
  schoolId       Int
  name           String
  status         AcademicSessionStatus      @default(DRAFT)

  startDate      DateTime
  endDate        DateTime

  school         School                     @relation(fields:[schoolId], references:[id])
  terms          Term[]
  classes        SchoolClass[]
  classHistory   StudentClassHistory[]

  feeAssignments FeeAssignment[]

  exams          Exam[]

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id             Int                        @id @default(autoincrement())
  sessionId      Int
  term           AcademicTerm
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean                    @default(false)

  session        AcademicSession            @relation(fields:[sessionId], references:[id])

  feeAssignments FeeAssignment[]

  exams          Exam[]

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([sessionId, term])
  @@index([sessionId])
}

// ------------------------------------------------------------
// CLASSES
// ------------------------------------------------------------
model SchoolClass {
  id                Int                        @id @default(autoincrement())
  schoolId          Int
  sessionId         Int
  name              String
  section           String?
  classTeacherId    Int?
  status            RecordStatus               @default(ACTIVE)

  school            School                     @relation(fields:[schoolId], references:[id])
  session           AcademicSession            @relation(fields:[sessionId], references:[id])
  classTeacher      Teacher?                   @relation(fields:[classTeacherId], references:[id])

  students          Student[]
  subjects          ClassSubject[]
  studentHistory    StudentClassHistory[]

  feeAssignments    FeeAssignment[]

  attendanceRecords AttendanceRecord[]

  exams             Exam[]

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([schoolId, sessionId, name, section])
  @@index([schoolId])
  @@index([sessionId])
  @@index([classTeacherId])
}

// ------------------------------------------------------------
// EXAMS
// ------------------------------------------------------------
model Exam {
  id        Int                        @id @default(autoincrement())
  schoolId  Int
  sessionId Int
  termId    Int
  classId   Int

  name      String
  startDate DateTime
  endDate   DateTime
  status    ExamStatus                 @default(DRAFT)
  isActive  Boolean                    @default(true)

  school    School                     @relation(fields:[schoolId], references:[id])
  session   AcademicSession            @relation(fields:[sessionId], references:[id])
  term      Term                       @relation(fields:[termId], references:[id])
  class     SchoolClass                @relation(fields:[classId], references:[id])

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([schoolId, sessionId, termId, classId, name])
  @@index([schoolId])
  @@index([sessionId])
  @@index([termId])
  @@index([classId])
  @@index([status])
}

// ------------------------------------------------------------
// SUBJECTS
// ------------------------------------------------------------
model Subject {
  id        Int                        @id @default(autoincrement())
  schoolId  Int
  code      String?
  name      String
  status    RecordStatus               @default(ACTIVE)

  school    School                     @relation(fields:[schoolId], references:[id])
  classes   ClassSubject[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSubject {
  id        Int         @id @default(autoincrement())
  classId   Int
  subjectId Int
  teacherId Int?

  class     SchoolClass @relation(fields:[classId], references:[id])
  subject   Subject     @relation(fields:[subjectId], references:[id])
  teacher   Teacher?    @relation(fields:[teacherId], references:[id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
}

// ------------------------------------------------------------
// STUDENTS
// ------------------------------------------------------------
model Student {
  id                Int                        @id @default(autoincrement())
  schoolId          Int
  userId            Int?                       @unique
  permanentId       String                     @unique

  firstName         String
  middleName        String?
  lastName          String

  dateOfBirth       DateTime?
  gender            Gender?
  phone             String?
  address           String?
  photoUrl          String?

  admissionDate     DateTime?
  status            StudentStatus              @default(ACTIVE)

  currentClassId    Int?

  school            School                     @relation(fields:[schoolId], references:[id])
  user              User?                      @relation(fields:[userId], references:[id])
  currentClass      SchoolClass?               @relation(fields:[currentClassId], references:[id])

  parents           StudentParent[]
  history           StudentClassHistory[]

  feeAssignments    FeeAssignment[]
  payments          Payment[]

  attendanceRecords AttendanceRecord[]

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([schoolId])
  @@index([currentClassId])
  @@index([status])
  @@index([lastName])
}

// ------------------------------------------------------------
// PARENTS / GUARDIANS
// ------------------------------------------------------------
model Parent {
  id          Int                        @id @default(autoincrement())
  schoolId    Int
  userId      Int?                       @unique
  permanentId String                     @unique

  firstName   String
  middleName  String?
  lastName    String
  phone       String?
  email       String?
  address     String?

  status      RecordStatus               @default(ACTIVE)

  school      School                     @relation(fields:[schoolId], references:[id])
  user        User?                      @relation(fields:[userId], references:[id])
  students    StudentParent[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([schoolId])
  @@index([lastName])
}

// ------------------------------------------------------------
// STUDENT ↔ PARENT
// ------------------------------------------------------------
model StudentParent {
  id           Int     @id @default(autoincrement())
  studentId    Int
  parentId     Int
  relationship String
  isPrimary    Boolean @default(false)

  student      Student @relation(fields:[studentId], references:[id])
  parent       Parent  @relation(fields:[parentId], references:[id])

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

// ------------------------------------------------------------
// TEACHERS
// ------------------------------------------------------------
model Teacher {
  id             Int                        @id @default(autoincrement())
  schoolId       Int
  userId         Int?                       @unique
  permanentId    String                     @unique

  firstName      String
  middleName     String?
  lastName       String
  phone          String?
  email          String?
  address        String?
  status         RecordStatus               @default(ACTIVE)

  school         School                     @relation(fields:[schoolId], references:[id])
  user           User?                      @relation(fields:[userId], references:[id])

  subjects       ClassSubject[]
  classTeacherOf SchoolClass[]

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([schoolId])
  @@index([lastName])
}

// ------------------------------------------------------------
// STUDENT CLASS HISTORY
// ------------------------------------------------------------
model StudentClassHistory {
  id        Int                        @id @default(autoincrement())
  studentId Int
  classId   Int
  sessionId Int
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean                    @default(false)

  student   Student                    @relation(fields:[studentId], references:[id])
  class     SchoolClass                @relation(fields:[classId], references:[id])
  session   AcademicSession            @relation(fields:[sessionId], references:[id])

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@index([studentId])
  @@index([classId])
  @@index([sessionId])
}

// ------------------------------------------------------------
// ATTENDANCE
// ------------------------------------------------------------
model AttendanceSetting {
  id          Int                        @id @default(autoincrement())
  schoolId    Int                        @unique
  callsPerDay Int                        @default(1)

  school      School                     @relation(fields:[schoolId], references:[id])

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model AttendanceRecord {
  id             Int                        @id @default(autoincrement())
  schoolId       Int
  studentId      Int
  classId        Int
  attendanceDate DateTime
  period         AttendancePeriod
  status         AttendanceStatus
  markedByUserId Int

  school         School                     @relation(fields:[schoolId], references:[id])
  student        Student                    @relation(fields:[studentId], references:[id])
  class          SchoolClass                @relation(fields:[classId], references:[id])
  markedBy       User                       @relation(fields:[markedByUserId], references:[id])

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([studentId, attendanceDate, period])
  @@index([schoolId, attendanceDate])
  @@index([classId, attendanceDate, period])
  @@index([studentId, attendanceDate])
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------
model AuditLog {
  id        Int               @id @default(autoincrement())
  schoolId  Int
  userId    Int?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  createdAt TimestamptzString @default(now())

  user      User?             @relation(fields:[userId], references:[id])

  @@index([schoolId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ------------------------------------------------------------
// FEES
// ------------------------------------------------------------
enum FeeTypeStatus {
  ACTIVE
  INACTIVE
}

enum FeeAssignmentStatus {
  ACTIVE
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  ONLINE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

// ------------------------------------------------------------
// FEE TYPES
// ------------------------------------------------------------
model FeeType {
  id          Int                        @id @default(autoincrement())
  schoolId    Int
  name        String
  description String?
  status      FeeTypeStatus              @default(ACTIVE)

  school      School                     @relation(fields:[schoolId], references:[id])
  assignments FeeAssignment[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([status])
}

// ------------------------------------------------------------
// FEE ASSIGNMENTS
// ------------------------------------------------------------
model FeeAssignment {
  id          Int                        @id @default(autoincrement())
  schoolId    Int
  studentId   Int
  feeTypeId   Int
  sessionId   Int
  termId      Int?
  classId     Int?
  amount      Decimal
  dueDate     DateTime?
  description String?
  status      FeeAssignmentStatus        @default(ACTIVE)

  school      School                     @relation(fields:[schoolId], references:[id])
  student     Student                    @relation(fields:[studentId], references:[id])
  feeType     FeeType                    @relation(fields:[feeTypeId], references:[id])
  session     AcademicSession            @relation(fields:[sessionId], references:[id])
  term        Term?                      @relation(fields:[termId], references:[id])
  class       SchoolClass?               @relation(fields:[classId], references:[id])

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([schoolId])
  @@index([studentId])
  @@index([feeTypeId])
  @@index([sessionId])
  @@index([termId])
  @@index([classId])
  @@index([status])
}

// ------------------------------------------------------------
// PAYMENTS
// ------------------------------------------------------------
model Payment {
  id            Int                        @id @default(autoincrement())
  schoolId      Int
  studentId     Int
  cashierUserId Int
  amount        Decimal
  method        PaymentMethod
  paymentDate   DateTime
  reference     String?
  description   String?
  status        PaymentStatus              @default(COMPLETED)

  school        School                     @relation(fields:[schoolId], references:[id])
  student       Student                    @relation(fields:[studentId], references:[id])
  cashier       User                       @relation(fields:[cashierUserId], references:[id])
  receipt       Receipt?

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([schoolId])
  @@index([studentId])
  @@index([cashierUserId])
  @@index([paymentDate])
  @@index([status])
}

// ------------------------------------------------------------
// RECEIPTS
// ------------------------------------------------------------
model Receipt {
  id            Int                        @id @default(autoincrement())
  schoolId      Int
  paymentId     Int                        @unique
  receiptNumber String                     @unique

  school        School                     @relation(fields:[schoolId], references:[id])
  payment       Payment                    @relation(fields:[paymentId], references:[id])

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([schoolId])
}
