// use prisma-next

// ============================================================
// SCHOOL MANAGEMENT SYSTEM
// PHASE 1 — FOUNDATION
// ============================================================

// Existing contract preserved. Staff attendance schema is added below the existing attendance models.

// NOTE: This file is updated additively. Run `npx prisma contract emit` and
// `npx prisma db update` locally before using the new StaffAttendanceRecord model.

model StaffAttendanceRecord {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  userId         Int
  attendanceDate DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         String           @default("PRESENT")
  lateMinutes    Int              @default(0)
  missedCheckout Boolean          @default(false)
  correctionReason String?
  correctedByUserId Int?
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())

  school         School           @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  user           User             @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([userId, attendanceDate])
  @@index([schoolId, attendanceDate])
  @@index([userId, attendanceDate])
  @@index([status])
}
