// use prisma-next

// ============================================================
// SCHOOL MANAGEMENT SYSTEM
// PHASE 1 — FOUNDATION
// ============================================================

// NOTE: This contract is intentionally kept structurally compatible
// with the existing application. Attendance enhancements are additive
// except for expanding the attendance status enum.

enum UserStatus { PENDING ACTIVE SUSPENDED DISABLED }
enum UserSessionStatus { ACTIVE LOCKED REVOKED EXPIRED }
enum PasswordRecoveryMethod { EMAIL PHONE }
enum PasswordRecoveryStatus { PENDING ACTIVATED EXPIRED CANCELLED }
enum PasswordRecoveryReason { PASSWORD_FORGOT NEW_DEVICE SUSPICIOUS }
enum UserType { OWNER ADMIN TEACHER CASHIER STUDENT PARENT STAFF }
enum Gender { MALE FEMALE OTHER }
enum AcademicTerm { FIRST SECOND THIRD }
enum AcademicSessionStatus { DRAFT ACTIVE COMPLETED ARCHIVED }
enum RecordStatus { ACTIVE INACTIVE }
enum StudentStatus { ACTIVE GRADUATED TRANSFERRED WITHDRAWN SUSPENDED INACTIVE }
enum AttendancePeriod { FIRST_PERIOD SECOND_PERIOD }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }
enum ExamStatus { DRAFT PUBLISHED CLOSED }
enum ResultStatus { DRAFT FINAL PUBLISHED }

model School {
  id Int @id @default(autoincrement())
  name String
  logoUrl String?
  address String?
  phone String?
  email String?
  website String?
  registrationInfo String?
  motto String?
  principalName String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  users User[]
  userSessions UserSession[]
  passwordRecoveries PasswordRecovery[]
  academicSessions AcademicSession[]
  classes SchoolClass[]
  subjects Subject[]
  students Student[]
  parents Parent[]
  teachers Teacher[]
  feeTypes FeeType[]
  feeAssignments FeeAssignment[]
  payments Payment[]
  receipts Receipt[]
  attendanceSetting AttendanceSetting?
  attendanceRecords AttendanceRecord[]
  staffAttendanceRecords StaffAttendanceRecord[]
  exams Exam[]
  results Result[]
  features SchoolFeature[]
  announcements Announcement[]
}

model User {
  id Int @id @default(autoincrement())
  schoolId Int
  permanentId String @unique
  email String?
  username String?
  phone String?
  passwordHash String
  name String
  userType UserType
  status UserStatus @default(PENDING)
  emailVerifiedAt TimestamptzString?
  phoneVerifiedAt TimestamptzString?
  roleRestrictedUntil TimestamptzString?
  roleRestrictionReason String?
  school School @relation(fields:[schoolId], references:[id])
  roles UserRole[]
  sessions UserSession[]
  passwordRecoveries PasswordRecovery[]
  auditLogs AuditLog[]
  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")
  paymentsReceived Payment[]
  attendanceRecords AttendanceRecord[]
  staffAttendanceRecords StaffAttendanceRecord[]
  resultsEntered Result[] @relation("ResultEnteredBy")
  resultsUpdated Result[] @relation("ResultUpdatedBy")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([schoolId])
  @@index([status])
  @@index([userType])
  @@unique([schoolId, username])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
}

model Role {
  id Int @id @default(autoincrement())
  name String
  description String?
  isSystem Boolean @default(false)
  users UserRole[]
  permissions RolePermission[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([name])
}
model UserRole {
  id Int @id @default(autoincrement())
  userId Int
  roleId Int
  user UserRoleUserRelationPlaceholder
  role UserRoleRoleRelationPlaceholder
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id Int @id @default(autoincrement())
  userId Int
  schoolId Int
  sessionKey String @unique
  deviceName String?
  deviceId String
  ipAddress String?
  userAgent String?
  status UserSessionStatus @default(ACTIVE)
  lastActivityAt TimestamptzString @default(now())
  lockedAt TimestamptzString?
  revokedAt TimestamptzString?
  expiresAt TimestamptzString?
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  school School @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  passwordRecoveries PasswordRecovery[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([userId]) @@index([schoolId]) @@index([status]) @@index([userId, status])
}

model PasswordRecovery {
  id Int @id @default(autoincrement())
  userId Int
  schoolId Int
  method PasswordRecoveryMethod
  status PasswordRecoveryStatus @default(PENDING)
  reason PasswordRecoveryReason @default(PASSWORD_FORGOT)
  tokenHash String
  verificationCodeHash String?
  newPasswordHash String
  requestedAt TimestamptzString @default(now())
  verifiedAt TimestamptzString?
  activateAt TimestamptzString
  expiresAt TimestamptzString?
  usedAt TimestamptzString?
  newDevice Boolean @default(false)
  roleRestrictedUntil TimestamptzString?
  ipAddress String?
  userAgent String?
  deviceSessionId Int?
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  school School @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  deviceSession UserSession? @relation(fields:[deviceSessionId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([userId]) @@index([schoolId]) @@index([status]) @@index([tokenHash]) @@index([activateAt]) @@index([deviceSessionId])
}

model Permission {
  id Int @id @default(autoincrement())
  code String @unique
  name String
  description String?
  roles RolePermission[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model RolePermission {
  id Int @id @default(autoincrement())
  roleId Int
  permissionId Int
  role Role @relation(fields:[roleId], references:[id])
  permission Permission @relation(fields:[permissionId], references:[id])
  @@unique([roleId, permissionId]) @@index([roleId]) @@index([permissionId])
}

model AcademicSession {
  id Int @id @default(autoincrement())
  schoolId Int
  name String
  status AcademicSessionStatus @default(DRAFT)
  startDate DateTime
  endDate DateTime
  school School @relation(fields:[schoolId], references:[id])
  terms Term[]
  classes SchoolClass[]
  classHistory StudentClassHistory[]
  feeAssignments FeeAssignment[]
  exams Exam[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([schoolId, name]) @@index([schoolId])
}
model Term {
  id Int @id @default(autoincrement())
  sessionId Int
  term AcademicTerm
  name String
  startDate DateTime
  endDate DateTime
  isActive Boolean @default(false)
  session AcademicSession @relation(fields:[sessionId], references:[id])
  feeAssignments FeeAssignment[]
  exams Exam[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([sessionId, term]) @@index([sessionId])
}
model SchoolClass {
  id Int @id @default(autoincrement())
  schoolId Int
  sessionId Int
  name String
  section String?
  classTeacherId Int?
  status RecordStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  session AcademicSession @relation(fields:[sessionId], references:[id])
  classTeacher Teacher? @relation(fields:[classTeacherId], references:[id])
  students Student[]
  subjects ClassSubject[]
  studentHistory StudentClassHistory[]
  feeAssignments FeeAssignment[]
  attendanceRecords AttendanceRecord[]
  exams Exam[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([schoolId, sessionId, name, section]) @@index([schoolId]) @@index([sessionId]) @@index([classTeacherId])
}
model Exam {
  id Int @id @default(autoincrement())
  schoolId Int
  sessionId Int
  termId Int
  classId Int
  name String
  startDate DateTime
  endDate DateTime
  status ExamStatus @default(DRAFT)
  isActive Boolean @default(true)
  school School @relation(fields:[schoolId], references:[id])
  session AcademicSession @relation(fields:[sessionId], references:[id])
  term Term @relation(fields:[termId], references:[id])
  class SchoolClass @relation(fields:[classId], references:[id])
  subjects ExamSubject[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([schoolId, sessionId, termId, classId, name]) @@index([schoolId]) @@index([sessionId]) @@index([termId]) @@index([classId]) @@index([status])
}
model Subject {
  id Int @id @default(autoincrement())
  schoolId Int
  code String?
  name String
  status RecordStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  classes ClassSubject[]
  examSubjects ExamSubject[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([schoolId, name]) @@index([schoolId])
}
model ClassSubject {
  id Int @id @default(autoincrement())
  classId Int
  subjectId Int
  teacherId Int?
  class SchoolClass @relation(fields:[classId], references:[id])
  subject Subject @relation(fields:[subjectId], references:[id])
  teacher Teacher? @relation(fields:[teacherId], references:[id])
  @@unique([classId, subjectId]) @@index([classId]) @@index([subjectId]) @@index([teacherId])
}
model ExamSubject {
  id Int @id @default(autoincrement())
  examId Int
  subjectId Int
  maxMark Int
  isActive Boolean @default(true)
  exam Exam @relation(fields:[examId], references:[id])
  subject Subject @relation(fields:[subjectId], references:[id])
  components AssessmentComponent[]
  results Result[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([examId, subjectId]) @@index([examId]) @@index([subjectId])
}
model AssessmentComponent {
  id Int @id @default(autoincrement())
  examSubjectId Int
  name String
  maxMark Int
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  examSubject ExamSubject @relation(fields:[examSubjectId], references:[id])
  resultMarks ResultMark[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([examSubjectId, name]) @@index([examSubjectId])
}
model Result {
  id Int @id @default(autoincrement())
  schoolId Int
  examSubjectId Int
  studentId Int
  totalMark Decimal
  grade String?
  position Int?
  status ResultStatus @default(DRAFT)
  enteredByUserId Int?
  updatedByUserId Int?
  school School @relation(fields:[schoolId], references:[id])
  examSubject ExamSubject @relation(fields:[examSubjectId], references:[id])
  student Student @relation(fields:[studentId], references:[id])
  enteredBy User? @relation("ResultEnteredBy", fields:[enteredByUserId], references:[id])
  updatedBy User? @relation("ResultUpdatedBy", fields:[updatedByUserId], references:[id])
  marks ResultMark[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([examSubjectId, studentId]) @@index([schoolId]) @@index([examSubjectId]) @@index([studentId]) @@index([status])
}
model ResultMark {
  id Int @id @default(autoincrement())
  resultId Int
  assessmentComponentId Int
  mark Decimal
  result Result @relation(fields:[resultId], references:[id])
  assessmentComponent AssessmentComponent @relation(fields:[assessmentComponentId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([resultId, assessmentComponentId]) @@index([resultId]) @@index([assessmentComponentId])
}
model Student {
  id Int @id @default(autoincrement())
  schoolId Int
  userId Int? @unique
  permanentId String @unique
  firstName String
  middleName String?
  lastName String
  dateOfBirth DateTime?
  gender Gender?
  phone String?
  address String?
  photoUrl String?
  admissionDate DateTime?
  status StudentStatus @default(ACTIVE)
  currentClassId Int?
  school School @relation(fields:[schoolId], references:[id])
  user User? @relation(fields:[userId], references:[id])
  currentClass SchoolClass? @relation(fields:[currentClassId], references:[id])
  parents StudentParent[]
  history StudentClassHistory[]
  feeAssignments FeeAssignment[]
  payments Payment[]
  attendanceRecords AttendanceRecord[]
  results Result[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([schoolId]) @@index([currentClassId]) @@index([status]) @@index([lastName])
}
model Parent {
  id Int @id @default(autoincrement())
  schoolId Int
  userId Int? @unique
  permanentId String @unique
  firstName String
  middleName String?
  lastName String
  phone String?
  email String?
  address String?
  status RecordStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  user User? @relation(fields:[userId], references:[id])
  students StudentParent[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([schoolId]) @@index([lastName])
}
model StudentParent {
  id Int @id @default(autoincrement())
  studentId Int
  parentId Int
  relationship String
  isPrimary Boolean @default(false)
  student Student @relation(fields:[studentId], references:[id])
  parent Parent @relation(fields:[parentId], references:[id])
  @@unique([studentId, parentId]) @@index([studentId]) @@index([parentId])
}
model Teacher {
  id Int @id @default(autoincrement())
  schoolId Int
  userId Int? @unique
  permanentId String @unique
  firstName String
  middleName String?
  lastName String
  phone String?
  email String?
  address String?
  status RecordStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  user User? @relation(fields:[userId], references:[id])
  subjects ClassSubject[]
  classTeacherOf SchoolClass[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([schoolId]) @@index([lastName])
}
model StudentClassHistory {
  id Int @id @default(autoincrement())
  studentId Int
  classId Int
  sessionId Int
  startDate DateTime
  endDate DateTime?
  isCurrent Boolean @default(false)
  student Student @relation(fields:[studentId], references:[id])
  class SchoolClass @relation(fields:[classId], references:[id])
  session AcademicSession @relation(fields:[sessionId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([studentId]) @@index([classId]) @@index([sessionId])
}

model AttendanceSetting {
  id Int @id @default(autoincrement())
  schoolId Int @unique
  callsPerDay Int @default(1)
  correctionWindowMinutes Int @default(60)
  staffCheckInEnabled Boolean @default(true)
  staffCheckOutRequired Boolean @default(false)
  lateGraceMinutes Int @default(15)
  schoolStartTime String?
  schoolClosingTime String?
  missedCheckOutBehavior String @default("FLAG")
  offlineAttendanceEnabled Boolean @default(false)
  parentAbsenceNotificationEnabled Boolean @default(true)
  parentLateNotificationEnabled Boolean @default(true)
  school School @relation(fields:[schoolId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AttendanceRecord {
  id Int @id @default(autoincrement())
  schoolId Int
  studentId Int
  classId Int
  attendanceDate DateTime
  period AttendancePeriod
  status AttendanceStatus
  reason String?
  checkInAt DateTime?
  checkOutAt DateTime?
  markedByUserId Int
  syncedAt DateTime?
  school School @relation(fields:[schoolId], references:[id])
  student Student @relation(fields:[studentId], references:[id])
  class SchoolClass @relation(fields:[classId], references:[id])
  markedBy User @relation(fields:[markedByUserId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  @@unique([studentId, attendanceDate, period])
  @@index([schoolId, attendanceDate])
  @@index([classId, attendanceDate, period])
  @@index([studentId, attendanceDate])
}

model StaffAttendanceRecord {
  id Int @id @default(autoincrement())
  schoolId Int
  userId Int
  attendanceDate DateTime
  period AttendancePeriod @default(FIRST_PERIOD)
  checkInAt DateTime?
  checkOutAt DateTime?
  status AttendanceStatus @default(PRESENT)
  lateReason String?
  missedCheckOut Boolean @default(false)
  source String @default("ONLINE")
  syncedAt DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  school School @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  @@unique([userId, attendanceDate, period])
  @@index([schoolId, attendanceDate])
  @@index([userId, attendanceDate])
}

model Announcement {
  id Int @id @default(autoincrement())
  schoolId Int
  createdByUserId Int
  title String
  message String
  audience String @default("ALL")
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  school School @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  createdBy User @relation("AnnouncementCreatedBy", fields:[createdByUserId], references:[id])
  @@index([schoolId]) @@index([createdByUserId]) @@index([isPublished]) @@index([publishedAt])
}
model AuditLog {
  id Int @id @default(autoincrement())
  schoolId Int
  userId Int?
  action String
  entity String
  entityId String?
  oldValue String?
  newValue String?
  ipAddress String?
  createdAt TimestamptzString @default(now())
  user User? @relation(fields:[userId], references:[id])
  @@index([schoolId]) @@index([userId]) @@index([entity]) @@index([createdAt])
}
model SchoolFeature {
  id Int @id @default(autoincrement())
  schoolId Int
  featureCode String
  name String
  description String?
  category String
  status String @default("AVAILABLE")
  enabled Boolean @default(false)
  isCore Boolean @default(false)
  sortOrder Int @default(0)
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  school School @relation(fields:[schoolId], references:[id], onDelete: Cascade)
  @@unique([schoolId, featureCode]) @@index([schoolId]) @@index([status]) @@index([enabled])
}

enum FeeTypeStatus { ACTIVE INACTIVE }
enum FeeAssignmentStatus { ACTIVE WAIVED CANCELLED }
enum PaymentMethod { CASH BANK_TRANSFER POS ONLINE OTHER }
enum PaymentStatus { COMPLETED REFUNDED CANCELLED }
model FeeType {
  id Int @id @default(autoincrement())
  schoolId Int
  name String
  description String?
  status FeeTypeStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  assignments FeeAssignment[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@unique([schoolId, name]) @@index([schoolId]) @@index([status])
}
model FeeAssignment {
  id Int @id @default(autoincrement())
  schoolId Int
  studentId Int
  feeTypeId Int
  sessionId Int
  termId Int?
  classId Int?
  amount Decimal
  dueDate DateTime?
  description String?
  status FeeAssignmentStatus @default(ACTIVE)
  school School @relation(fields:[schoolId], references:[id])
  student Student @relation(fields:[studentId], references:[id])
  feeType FeeType @relation(fields:[feeTypeId], references:[id])
  session AcademicSession @relation(fields:[sessionId], references:[id])
  term Term? @relation(fields:[termId], references:[id])
  class SchoolClass? @relation(fields:[classId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([schoolId]) @@index([studentId]) @@index([feeTypeId]) @@index([sessionId]) @@index([termId]) @@index([classId]) @@index([status])
}
model Payment {
  id Int @id @default(autoincrement())
  schoolId Int
  studentId Int
  cashierUserId Int
  amount Decimal
  method PaymentMethod
  paymentDate DateTime
  reference String?
  description String?
  status PaymentStatus @default(COMPLETED)
  school School @relation(fields:[schoolId], references:[id])
  student Student @relation(fields:[studentId], references:[id])
  cashier User @relation(fields:[cashierUserId], references:[id])
  receipt Receipt?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  @@index([schoolId]) @@index([studentId]) @@index([cashierUserId]) @@index([paymentDate]) @@index([status])
}
model Receipt {
  id Int @id @default(autoincrement())
  schoolId Int
  paymentId Int @unique
  receiptNumber String @unique
  school School @relation(fields:[schoolId], references:[id])
  payment Payment @relation(fields:[paymentId], references:[id])
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  @@index([schoolId])
}

// Placeholder relation names above are intentionally not used by the
// application. They must be replaced by normal Prisma relations before
// contract emission.
model UserRoleUserRelationPlaceholder { id Int @id @default(autoincrement()) }
model UserRoleRoleRelationPlaceholder { id Int @id @default(autoincrement()) }
